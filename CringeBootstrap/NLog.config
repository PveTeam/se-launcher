<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd">
        
        <extensions>
            <add assembly="NLog.Targets.AtomicFile" />
        </extensions>

        <!-- the targets to write to -->
        <targets>
            <default-wrapper xsi:type="AsyncWrapper" overflowAction="Block" />

            <!-- write logs to file  -->
            <target xsi:type="AtomFile" name="allfile" 
                    fileName="${specialfolder:folder=ApplicationData}/CringeLauncher/logs/log-${shortdate}.log"
                    layout="[${longdate}] ${uppercase:${level}} ${logger}: ${message}" />

            <target xsi:type="AtomFile" name="error"
                    fileName="${specialfolder:folder=ApplicationData}/CringeLauncher/logs/log-error-${shortdate}.log"
                    layout="[${longdate}] ${uppercase:${level}} ${logger}: ${message} ${cringe-exception}" />

            <target name="debugger" xsi:type="Debugger" layout="${logger:shortName=true}: ${message} ${cringe-exception}"/>
            
            <target xsi:type="ColoredConsole" name="console" layout="[${longdate}] ${uppercase:${level}} ${logger:shortName=true}: ${message} ${cringe-exception}" />
        </targets>

        <!-- rules to map from logger name to target -->
        <rules>
            <logger name="*" level="Error,Fatal" writeTo="error" />
            <logger name="*" level="Info,Error,Fatal" writeTo="allfile,debugger,console" />
            <logger name="*" level="Debug" writeTo="debugger" />
        </rules>
    </nlog>

</configuration>