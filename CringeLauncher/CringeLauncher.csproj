<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <NoWarn>$(NoWarn);WFO1000</NoWarn>
    </PropertyGroup>
    
    <!-- Xplat -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    </PropertyGroup>
    
    <!-- Windows only -->
    <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
        <UseWindowsForms>true</UseWindowsForms>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Xplat -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <Using Include="System.Drawing" />

        <PackageReference Include="Silk.NET.SDL" />
        <PackageReference Include="Silk.NET.SDL.Native" ExcludeAssets="native" />
    </ItemGroup>

    <!-- Windows only -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
        <PackageReference Include="EOSSDK" />
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="VRage:VRage.Plugins.MyPlugins.LoadPlugins" />
        <Publicize Include="SpaceEngineers.Game:SpaceEngineers.Game.SpaceEngineersGame.OnRenderInitialized" />
        <Publicize Include="Sandbox.Game:Sandbox.Engine.Platform.Game.set_DrawThread" />
        <Publicize Include="Sandbox.Game:Sandbox.MySandboxGame.form" />
        <Publicize Include="Sandbox.Game:Sandbox.MySandboxGame.RenderThread_SizeChanged" />
        <Publicize Include="Sandbox.Game:Sandbox.MySandboxGame.Window_OnManualWindowCloseRequest" />
        <Publicize Include="Sandbox.Game:Sandbox.MySandboxGame.OnExit" />
        <Publicize Include="Sandbox.Game:Sandbox.MySandboxGame.CheckGraphicsCard" />
        <Publicize Include="VRage.Render;VRage.Render11;VRage.Platform.Windows;VRage.Scripting;VRage.Input" IncludeCompilerGeneratedMembers="false" />
		<Publicize Include="VRage.Scripting:VRage.Scripting.Rewriters.ProtoTagRewriter" />
		<Publicize Include="Sandbox.Game:Sandbox.Game.World.MyScriptManager.m_compatibilityChanges" />
		<Publicize Include="Sandbox.Game:Sandbox.Game.World.MyScriptManager.UpdateCompatibility" />
		<Publicize Include="Sandbox.Game:Sandbox.Game.World.MyScriptManager.COMPATIBILITY_USINGS" />
		<Publicize Include="Sandbox.Game:Sandbox.Engine.Platform.Game.m_gameTimer" />
		<Publicize Include="VRage.Scripting:VRage.Scripting.MyScriptCompiler" />
		<Publicize Include="VRage.Library:ParallelTasks.PrioritizedScheduler+Worker" />
		<Publicize Include="VRage.Audio:VRage.Audio.MyMusicState" />
	</ItemGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" />
        <PackageReference Include="Basic.Reference.Assemblies.Net100" />
        <PackageReference Include="dnlib" />
        <PackageReference Include="Krafs.Publicizer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Polly" />
        <PackageReference Include="Demystifier" />
        <PackageReference Include="System.Management" />
        <PackageReference Include="System.Private.ServiceModel" />
        <PackageReference Include="System.Formats.Nrbf" />
        <PackageReference Include="Velopack" />
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NLog" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="SpaceEngineersDedicated.ReferenceAssemblies" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CringeBootstrap.Abstractions\CringeBootstrap.Abstractions.csproj" />
        <ProjectReference Include="..\CringePlugins\CringePlugins.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="NativeMethods.txt" />
      <Content Include="Resources\splash.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Fonts\OFL.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Resources\Fonts\*.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Render\Win\EarlyWindow.cs">
        <SubType>Form</SubType>
      </Compile>
    </ItemGroup>

</Project>
