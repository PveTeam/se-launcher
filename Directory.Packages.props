<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compat dependencies -->
    <PackageVersion Include="System.Runtime.Serialization.Formatters" Version="10.0.10" />
    <PackageVersion Include="System.Management" Version="10.0.10" />
    <PackageVersion Include="Steamworks.NET" Version="[20.1.0]" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.0.0-compat" />
    <PackageVersion Include="System.Private.ServiceModel" Version="4.10.3" />
    <PackageVersion Include="System.Formats.Nrbf" Version="10.0.10" />
    <PackageVersion Include="EOSSDK" Version="1.0.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Game version dependency -->
    <PackageVersion Include="SpaceEngineersDedicated.ReferenceAssemblies" Version="1.210.11.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test Plugin Dependencies -->
    <PackageVersion Include="CringePlugins" Version="*-preview*" />
    <PackageVersion Include="CringePlugins.MSBuild" Version="*" />
    <PackageVersion Include="NodaTime" Version="3.3.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.8.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.TemplateEngine.Utils" Version="10.0.302" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.10" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.1" />
    <PackageVersion Include="Demystifier" Version="1.0.3" />
    <PackageVersion Include="NLog" Version="6.1.4" />
    <PackageVersion Include="NLog.Schema" Version="6.1.4" />
    <PackageVersion Include="NLog.Targets.AtomicFile" Version="6.1.5" />
    <PackageVersion Include="JsonSchema.Net.Generation" Version="7.3.10" />
    <PackageVersion Include="Lib.Harmony.Thin" Version="2.4.2-torch" />
    <PackageVersion Include="ImGui.NET.DirectX" Version="1.92.3.6" />
    <PackageVersion Include="MonoMod.Core" Version="1.3.6" />
    <PackageVersion Include="dnlib" Version="4.5.0" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.6.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.6.0" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Silk.NET.SDL" Version="3.0.0-build1712.0" />
    <PackageVersion Include="Silk.NET.SDL.Native" Version="3.4.4-build1712.0" />
    <PackageVersion Include="Silk.NET.Core" Version="3.0.0-build1712.0" />
    <PackageVersion Include="CliWrap" Version="3.10.4" />
  </ItemGroup>
</Project>